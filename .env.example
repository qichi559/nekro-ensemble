# ============================================================
# 三 Bot 语音系统 · 环境变量模板
# 复制为 .env 后填写真实值，切勿把真实密钥提交到仓库
# ============================================================

# ---------- 监控面板（bot_monitor.py）----------
# 面板访问密码：留空则启动时随机生成（会在启动日志打印一次）
SITE_PASSWORD=
# 你自己的 QQ 号（聊天页用户头像用，留空则用默认头像）
USER_QQ=
# 设备（小智 stackchan）绑定到第几个 bot 的卡片（0-based，2 表示第 3 个；-1 表示无设备）
DEVICE_BOT_INDEX=2

# ---------- NekroAgent 实例（每个实例一份 .env）----------
# 数据目录（各实例不同，例如 /home/ubuntu/srv/nekro_agent）
NEKRO_DATA_DIR=
# 实例名前缀（多实例区分用，留空为单实例）
INSTANCE_NAME=
NEKRO_EXPOSE_PORT=8021
NAPCAT_EXPOSE_PORT=6099
POSTGRES_PASSWORD=nekro_agent
QDRANT_API_KEY=
ONEBOT_ACCESS_TOKEN=
NEKRO_ADMIN_PASSWORD=

# ---------- 桥接 bridge（豆包 TTS + 设备链路）----------
TTS_API_KEY=
TTS_RESOURCE_ID=
TTS_VOICE=
LISTEN_PORT=8090
NEKRO_BASE_URL=http://127.0.0.1:8021
ACCESS_KEY=
OWNER_QQ=
OWNER_NAME=
BRIDGE_DATA_DIR=/opt/nekro-bridge

# ---------- QQ 语音补丁（patches/adapter.py）----------
# bridge TTS 接口地址，不同实例用不同端口（8090/8091/8092）
TTS_BRIDGE_URL=http://172.21.0.1:8090/api/tts
